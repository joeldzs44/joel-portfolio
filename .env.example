# Copy to .env.local for development; add the same names in Vercel → Settings → Environment Variables.
# Every feature is optional: without its variables it shows "Not available right now".

# Public URL of the site, used in email links and OpenRouter attribution.
NEXT_PUBLIC_SITE_URL=https://example.vercel.app

# Supabase (gallery, rate limits, interview cache). Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Resend (contact form + "new art commit" notifications).
RESEND_API_KEY=
CONTACT_TO_EMAIL=            # where messages are delivered — never committed anywhere else
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# OpenRouter (interview). Create a dedicated key with a credit limit.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=xiaomi/mimo-v2.6-flash

# Cloudflare Turnstile (bot check on every form).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Long random strings — generate each with: openssl rand -hex 32
SESSION_SECRET=
IP_HASH_SALT=
ADMIN_SECRET=
